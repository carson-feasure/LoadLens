{
  "name": "loadlens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts playwright.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "package:email": "npm run build && node scripts/package-email.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.14",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.4",
    "tailwindcss": "4.1.14"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
